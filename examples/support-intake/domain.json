  "mock": "mock/policy.ts",
  "evals": "evals",
  "entity": { "singular": "ticket", "plural": "tickets", "id_key": "entity_id" },
  "slot_labels": {
    "title": "Title",
    "customer_name": "Customer",
    "category": "Category",
    "priority": "Priority",
    "channel": "Channel",
    "environment": "Environment",
    "affected_users": "Affected users",
