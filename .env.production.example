# ── Marg — production environment ────────────────────────────────────────────
#   cp .env.production.example .env.production      # fill it, never commit it
#   docker compose -f deploy/docker-compose.yml --env-file .env.production up -d
# Every variable with its default: docs/ENVIRONMENT.md. Hostnames below are the
# compose service names (redis, mongo, openobserve, ollama).

NODE_ENV=production
AGENT_ENV=production
GATEWAY_PORT=8787
AGENT_BRAND=Marg
AGENT_SERVICE_NAMESPACE=marg

# ── The model — never the mock in production ─────────────────────────────────
LLM_CHAIN=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# A chain with failover (docs/ENVIRONMENT.md): LLM_CHAIN=openai,anthropic
# LLM_OPENAI_API_KEY=
# LLM_OPENAI_MODEL=
# LLM_OPENAI_PRICE=input,cached,output      # USD per million — the cost on every span

# ── Safety and identity (everything here fails closed) ───────────────────────
AGENT_ALLOW_WRITES=true
AGENT_REQUIRE_LOGIN=true
AGENT_AUTH_VERIFY_URL=https://api.example.com/me     # every bearer is verified here
AGENT_TOKEN_SECRET=                                  # ≥32 random bytes, base64 — the agent-token exchange (docs/SDK-AUTH.md)
AGENT_APP_KEYS=                                      # key:tenant,key2:tenant2 — the apps allowed to exchange
# AGENT_ENTITLEMENT_URL=                             # seats and caps looked up at exchange
# AGENT_ENTITLEMENT_KEY=
AGENT_ADMIN_KEY=                                     # admin endpoints are closed until this is set
AGENT_CORS_ORIGINS=https://app.example.com
AGENT_TRUST_PROXY=true                               # behind Caddy / a load balancer
# AGENT_GATEWAY_KEYS=                                # optional shared keys clients must present
# AGENT_LINK_SCHEMES=myapp:                          # app deep-link schemes the widget may open (http/https always)
AGENT_ENTITY_DEEPLINK=https://app.example.com/items/{entity_id}
AGENT_MAX_MESSAGE_CHARS=4000

# ── Durable stores (compose profile "stores") ────────────────────────────────
AGENT_REDIS_URL=redis://redis:6379
AGENT_MONGO_URL=mongodb://mongo:27017
AGENT_MONGO_DB=marg
AGENT_SESSION_RETENTION_DAYS=30

# ── Limits and caps ──────────────────────────────────────────────────────────
AGENT_RATE_CHAT_PER_SESSION=10
AGENT_RATE_CHAT_PER_IP=60
AGENT_RATE_MAX_CONCURRENT=8
# AGENT_CAP_TOKENS_PER_SESSION=        # plan tokens; shown to users as a percentage
# AGENT_CAP_TOKENS_DAY=
# AGENT_CAP_TOKENS_MONTH=

# ── Typed decisions (compose profile "decisions": Ollama serving laya) ───────
# VERDICT_SYSTEMONE_URL=http://ollama:11434
# VERDICT_SYSTEMONE_MODEL=laya
# LAYA_MODEL=laya                      # what the ollama-pull job fetches

# ── Observability (compose profile "observability") ──────────────────────────
AGENT_O2_URL=http://openobserve:5080
AGENT_O2_USER=root@example.com
AGENT_O2_PASSWORD=
O2_ROOT_USER_EMAIL=root@example.com    # the OpenObserve container's root login — same two values
O2_ROOT_USER_PASSWORD=
AGENT_OTEL_CAPTURE_CONTENT=heads       # heads | full | off — what of the conversation reaches spans
# AGENT_ALERT_WEBHOOK=                 # where o2:bootstrap points the alerts

# ── Channels ─────────────────────────────────────────────────────────────────
# DEEPGRAM_API_KEY=                    # voice notes
# AGENT_MEDIA_DOMAIN=                  # the domain that implements the internal_* media tools

# ── Metering (pass-through) ──────────────────────────────────────────────────
# AGENT_METERING_URL=
# AGENT_METERING_API_KEY=

# ── Edge (compose profile "edge") ────────────────────────────────────────────
AGENT_DOMAIN=agent.example.com
