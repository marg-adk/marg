# ── Marg — development environment ───────────────────────────────────────────
# cp .env.example .env  (never commit .env). Every variable is documented with
# its default in docs/ENVIRONMENT.md. Unset = the safe default.

# ── The model ────────────────────────────────────────────────────────────────
# A chain of endpoints tried in order (failover + circuit breaker per endpoint).
# "mock" is the scripted offline model the example domain ships with — the whole
# journey runs with no key at all. Replace it with a real chain when ready, e.g.
#   LLM_CHAIN=openai,anthropic        LLM_CHAIN=ollama        LLM_CHAIN=anthropic
LLM_CHAIN=mock

# Anthropic (chain name "anthropic")
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# Any OpenAI-compatible endpoint (chain name = the LLM_<NAME>_* prefix; presets exist for
# openai, gemini, vertex, azure, bedrock, ollama, vllm, llamacpp, lmstudio, litellm, groq,
# mistral, deepseek, fireworks, together, openrouter, xai, cohere, huggingface, cerebras,
# perplexity, nvidia — docs/providers/ has the lines for each).
# LLM_OPENAI_API_KEY=
# LLM_OPENAI_MODEL=gpt-5.6-luna
# LLM_OLLAMA_MODEL=llama3.3          # base defaults to http://localhost:11434/v1, no key needed
# LLM_<NAME>_TEMPERATURE=0.3 | none  LLM_<NAME>_REASONING_EFFORT=low|none|omit  LLM_<NAME>_PRICE=in,cached,out

# Cheap model for the domain-routing hop (only used with two or more domains and no
# decision backend). Empty = the primary model.
# AGENT_ROUTER_MODEL=claude-haiku-4-5-20251001

# ── Typed decisions (Verdict — the open-source alternative to a decision-model API) ──
# A System One endpoint: Laya via Ollama (http://localhost:11434), laya-serve
# (http://localhost:8000), or any compatible server. Unset = rules + the LLM fallback.
# VERDICT_SYSTEMONE_URL=http://localhost:11434
# VERDICT_SYSTEMONE_MODEL=laya
# VERDICT_SYSTEMONE_API_KEY=
# VERDICT_MIN_CONFIDENCE=0.6

# ── Safety ───────────────────────────────────────────────────────────────────
# Writes happen only when this is the literal string "true" (evals and CI leave it off).
AGENT_ALLOW_WRITES=true
# The example domain needs no login; a real deployment keeps the default (true).
AGENT_REQUIRE_LOGIN=false
# Brand shown in the prompt identity line, the widget and error messages.
AGENT_BRAND=Marg

# ── Optional channels ────────────────────────────────────────────────────────
# DEEPGRAM_API_KEY=            # voice notes (speech-to-text); or an OpenAI-compatible Whisper:
# AGENT_STT_PROVIDER=deepgram | openai      AGENT_STT_BASE=http://localhost:8000/v1  AGENT_STT_MODEL=whisper-1
# AGENT_ENTITY_DEEPLINK=https://app.example.com/tickets/{entity_id}   # completion button URL template
# AGENT_MEDIA_DOMAIN=support-intake   # which domain implements the internal_* media tools

# ── Optional durable stores (in-memory / file fallback when unset) ───────────
# AGENT_REDIS_URL=redis://localhost:6379
# AGENT_MONGO_URL=mongodb://localhost:27017
# AGENT_MONGO_DB=marg

# ── Optional observability (OpenTelemetry → OpenObserve or any OTLP backend) ──
# AGENT_O2_URL=http://localhost:5080
# AGENT_O2_USER=root@example.com
# AGENT_O2_PASSWORD=
# OTEL_EXPORTER_OTLP_ENDPOINT=         # a collector instead of OpenObserve directly
# AGENT_OTEL_CAPTURE_CONTENT=heads     # heads | full | off

# ── Optional metering sink (pass-through: bill what vendors bill you) ─────────
# AGENT_METERING_URL=http://localhost:8090   AGENT_METERING_API_KEY=
