# dependencies
node_modules/

# local runtime state — never commit
.env
.env.*.local
.data/
.sessions/
.usage/
*.log
*.tsbuildinfo
.DS_Store

# eval transcripts (regenerated every run)
**/evals/results/
**/probe/results/

# python sidecars (Laya) if someone creates a venv here
.venv/
__pycache__/

# generated by `npm run o2:dashboards` (the bootstrap builds them in memory when absent)
observability/openobserve/dashboards/
observability/openobserve/alerts/

# build output (npm run build) — published to npm, never committed
packages/*/dist/
packages/*/LICENSE
packages/create-marg-app/payload/
packages/marg/payload/

# the site: mirrored content and build output (npm run site:build)
website/src/
website/.vitepress/cache/
website/.vitepress/dist/
